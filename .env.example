# Discord Bot Token
# ห้ามใส่ Token จริงลง GitHub
DISCORD_TOKEN=your_bot_token_here

# Server ID ของ AFT-SBTVC
# ใช้เพื่อให้ Slash Commands ซิงก์ในเซิร์ฟเวอร์ได้เร็วขึ้น
DISCORD_GUILD_ID=your_server_id_here

# Optional: ตำแหน่งไฟล์ SQLite
# Local ปล่อยว่างได้ บอทจะใช้ ./aft_sbtvc.db
# Railway + Volume: ถ้าไม่กำหนดค่านี้ บอทจะใช้ RAILWAY_VOLUME_MOUNT_PATH อัตโนมัติ
DATABASE_PATH=
